# ============================================================
#  CyberRakshak AI - Environment Variables
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# ============================================================

# IBM GRANITE - LLM 1 (Incident Intake Agent)
GRANITE_INTAKE_API_KEY=your_ibm_watsonx_api_key_here
GRANITE_INTAKE_PROJECT_ID=your_ibm_watsonx_project_id_here
GRANITE_INTAKE_URL=https://us-south.ml.cloud.ibm.com
GRANITE_INTAKE_MODEL=meta-llama/llama-3-3-70b-instruct

# IBM GRANITE - LLM 2 (Scam Analysis Agent)
GRANITE_SCAM_API_KEY=your_ibm_watsonx_api_key_here
GRANITE_SCAM_PROJECT_ID=your_ibm_watsonx_project_id_here
GRANITE_SCAM_URL=https://us-south.ml.cloud.ibm.com
GRANITE_SCAM_MODEL=meta-llama/llama-3-3-70b-instruct

# IBM GRANITE - LLM 3 (Evidence Organization Agent)
GRANITE_EVIDENCE_API_KEY=your_ibm_watsonx_api_key_here
GRANITE_EVIDENCE_PROJECT_ID=your_ibm_watsonx_project_id_here
GRANITE_EVIDENCE_URL=https://us-south.ml.cloud.ibm.com
GRANITE_EVIDENCE_MODEL=meta-llama/llama-3-3-70b-instruct

# GEMINI API - LLM 4 (Reporting Guidance Agent)
# Obtain: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# GROQ API - LLM 5 (Guidance Dashboard Agent)
# Obtain: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# MYSQL DATABASE
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=cyberrakshak_db

# FLASK
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change_this_to_a_long_random_secret_key

# FILE UPLOADS
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,pdf,txt,doc,docx
